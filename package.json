{
  "name": "mocktrader-futures",
  "version": "1.0.0",
  "description": "Portable commodity-futures quant core (data / factors / strategy / backtest / performance) + self-contained web prototype. Sandbox-safe alternative to the C# exe+dll build (S1-S8).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:e2e": "playwright test",
    "smoke": "node tools/smoke.mjs",
    "build:web": "node tools/build-web.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!dist/**": []
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20"
  }
}
