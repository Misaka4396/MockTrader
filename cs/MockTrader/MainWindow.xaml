<Window x:Class="MockTrader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MockTrader · 商品期货多空因子回测"
        Width="1260" Height="800" MinWidth="1000" MinHeight="660"
        Background="#F5F6F8" Foreground="#111827"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei, Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧：配置 -->
    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="品种池（多选）" Foreground="#111827" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectAllBtn" Content="全选" Click="SelectAll_Click" Padding="10,4" Margin="0,0,8,0" Background="#FFFFFF" Foreground="#0E7490" BorderBrush="#D1D5DB"/>
            <Button x:Name="SelectNoneBtn" Content="清空" Click="SelectNone_Click" Padding="10,4" Background="#FFFFFF" Foreground="#0E7490" BorderBrush="#D1D5DB"/>
          </StackPanel>
          <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="VarietyPanel"/>
            </ScrollViewer>
          </Border>

          <TextBlock Text="策略" Foreground="#111827" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
              <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
              <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Text="策略" VerticalAlignment="Center" Foreground="#374151"/>
            <ComboBox x:Name="StrategyCombo" Grid.Column="1" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
            <TextBlock Text="多头数量" Grid.Row="1" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="LongBox" Grid.Row="1" Grid.Column="1" Text="5" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
            <TextBlock Text="空头数量" Grid.Row="2" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="ShortBox" Grid.Row="2" Grid.Column="1" Text="5" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
            <TextBlock Text="权重方案" Grid.Row="3" VerticalAlignment="Center" Foreground="#374151"/>
            <ComboBox x:Name="WeightingCombo" Grid.Row="3" Grid.Column="1" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB"/>
            <TextBlock Text="合成方式" Grid.Row="4" VerticalAlignment="Center" Foreground="#374151"/>
            <ComboBox x:Name="CombineCombo" Grid.Row="4" Grid.Column="1" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB"/>
            <TextBlock Text="调仓频率" Grid.Row="5" VerticalAlignment="Center" Foreground="#374151"/>
            <ComboBox x:Name="RebalanceCombo" Grid.Row="5" Grid.Column="1" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB"/>
            <TextBlock Text="总敞口" Grid.Row="6" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="GrossBox" Grid.Row="6" Grid.Column="1" Text="1.0" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
            <TextBlock Text="初始资金" Grid.Row="7" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="CapitalBox" Grid.Row="7" Grid.Column="1" Text="10000000" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
            <TextBlock Text="纳指长线年化" Grid.Row="8" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="BenchmarkBox" Grid.Row="8" Grid.Column="1" Text="0.15" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock Text="基准为可配置常数（默认 15%，约 10 年口径），非纳指逐日曲线。CTA 与纳指低相关，此基准用于「是否值得主动交易」的决策参照。" TextWrapping="Wrap" Foreground="#6B7280" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 右侧：结果 -->
    <Grid Grid.Column="1" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Button x:Name="RunButton" Content="▶ 运行回测" Click="RunButton_Click" Padding="18,9" FontSize="15" FontWeight="Bold"
                Background="#0E7490" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"/>
        <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#6B7280"/>
      </StackPanel>
      <ProgressBar x:Name="ProgressBar" Grid.Row="0" Margin="0,10,0,0" Height="8" VerticalAlignment="Bottom" Minimum="0" Maximum="100" Value="0"
                   Background="#E5E7EB" Foreground="#0E7490" BorderBrush="#D1D5DB"/>

      <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock x:Name="VerdictText" Text="—" FontSize="34" FontWeight="Bold" Foreground="#D97706"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="策略年化" Foreground="#374151"/>
              <TextBlock x:Name="StrategyAnnualText" Grid.Column="1" Text="—" FontWeight="Bold" Foreground="#111827"/>
              <TextBlock Text="基准年化" Grid.Row="1" Foreground="#374151"/>
              <TextBlock x:Name="BenchmarkText" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="Bold" Foreground="#111827"/>
              <TextBlock Text="超额收益" Grid.Row="2" Foreground="#374151"/>
              <TextBlock x:Name="ExcessText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="Bold" Foreground="#111827"/>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="BenchNoteText" Grid.Column="2" Text="" TextWrapping="Wrap" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <UniformGrid Grid.Row="2" Columns="6" Margin="0,12,0,0">
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8"><StackPanel><TextBlock x:Name="KpiReturn" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="年化收益率" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8"><StackPanel><TextBlock x:Name="KpiSharpe" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="Sharpe" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8"><StackPanel><TextBlock x:Name="KpiVol" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="波动率" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8"><StackPanel><TextBlock x:Name="KpiMaxDD" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="最大回撤" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8"><StackPanel><TextBlock x:Name="KpiCalmar" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="卡玛比率" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel><TextBlock x:Name="KpiWin" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock Text="胜率" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/></StackPanel></Border>
      </UniformGrid>

      <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0">
        <Canvas x:Name="ChartCanvas" Background="#FFFFFF" ClipToBounds="True"/>
      </Border>

      <TextBlock x:Name="SummaryText" Grid.Row="4" Text="—" Margin="0,10,0,0" Foreground="#374151" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
